{
    "builds":[
        {
            "src":"./src/index.js",
            "use":"@vercel/node"
        }
    ],
    "functions": {
    "src/controllers/authController.js": {
      "maxDuration": 300
    }
  },
    "routes":[
        {
            "src":"/(.*)",
            "dest":"src/index.js"
        }
    ]
}